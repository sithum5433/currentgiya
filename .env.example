# Server settings. Copy to .env and keep .env out of version control.
PORT=3000
DATA_DIR=.data
# Set 1 ONLY behind a reverse proxy you control that replaces X-Forwarded-For.
TRUST_PROXY=0
# Railway public HTTP networking: TRUST_PROXY=1 and CLIENT_IP_HEADER=x-real-ip.
# This header is ignored unless proxy trust is enabled.
CLIENT_IP_HEADER=x-forwarded-for

# Optional background storm notifications. Generate with: npx web-push generate-vapid-keys
# HTTPS is required in production. The private key stays on this server.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional official-notice extraction: the running server refreshes daily when configured.
# `npm run notices` also refreshes on demand or from a deployment scheduler.
# Use current official notice pages or direct PDF/image URLs. HTTPS hosts are allowlisted.
# Sources and fetch limits are documented in scripts/refresh-notices.mjs.
# Examples only: https://www.ceb.lk/power-interruption/en and current pages from
# https://www.leco.lk/ or https://www.waterboard.lk/ (find their latest notice URLs).
# JavaScript-only portals may require a direct notice PDF/image URL.
NOTICE_SOURCE_URLS=
OPENAI_API_KEY=
OPENAI_NOTICE_MODEL=gpt-4.1-mini

# No key is needed for Open-Meteo model forecasts or the ipwho.is public IP lookup.
# Review service limits and terms for deployment. This is not lightning nowcasting.
# https://open-meteo.com/en/docs
# https://ipwhois.io/documentation
# https://developers.openai.com/api/docs/guides/structured-outputs
# https://developers.openai.com/api/docs/guides/file-inputs
